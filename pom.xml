<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>wildflyexample-parent</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>WildflyExample Parent</name>
    <description>Parent reactor for the WildFly app and Selenium TestNG browser tests</description>

    <modules>
        <module>app</module>
        <module>selenium-testng-tests</module>
        <module>selenium-cucumber-testng-tests</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>

        <jakarta.servlet.version>5.0.0</jakarta.servlet.version>
        <jakarta.json.version>2.1.1</jakarta.json.version>

        <!-- test tooling versions -->
        <junit.jupiter.version>5.9.3</junit.jupiter.version>
        <testng.version>7.10.2</testng.version>
        <cucumber.version>7.20.1</cucumber.version>
        <selenium.version>4.24.0</selenium.version>
        <coverage.integration.version>1.0.0-SNAPSHOT</coverage.integration.version>
        <mockito.version>5.3.1</mockito.version>
        <maven.surefire.plugin.version>3.0.0</maven.surefire.plugin.version>
        <hsqldb.version>2.7.4</hsqldb.version>
    </properties>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                    </configuration>
                </plugin>

                <plugin>
                    <artifactId>maven-war-plugin</artifactId>
                    <version>3.3.2</version>
                    <configuration>
                        <failOnMissingWebXml>false</failOnMissingWebXml>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
