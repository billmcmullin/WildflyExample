<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.example</groupId>
        <artifactId>wildflyexample-parent</artifactId>
        <version>1.0-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>

    <artifactId>selenium-cucumber-testng-tests</artifactId>
    <packaging>jar</packaging>

    <name>Selenium Cucumber Browser Tests (TestNG)</name>
    <description>Separate Selenium + Cucumber (TestNG) example with Parasoft coverage integration</description>

    <properties>
        <app.base.url>http://localhost:8080/app</app.base.url>
        <app.username>admin</app.username>
        <app.password>admin</app.password>

        <selenium.cucumber.tests.skip>true</selenium.cucumber.tests.skip>
        <testng.suite.file>src/test/resources/testng-cucumber.xml</testng.suite.file>
    </properties>

    <dependencies>
        <!-- Required TestNG runtime because Cucumber runner extends AbstractTestNGCucumberTests. -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Required Cucumber stack for feature parsing and TestNG runner integration. -->
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-java</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.cucumber</groupId>
            <artifactId>cucumber-testng</artifactId>
            <version>${cucumber.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Required browser automation APIs for scenario steps. -->
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Required Parasoft integration for Cucumber lifecycle reporting. -->
        <dependency>
            <groupId>com.parasoft</groupId>
            <artifactId>coverage-integration-cucumber</artifactId>
            <version>${coverage.integration.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Required Parasoft integration for Selenium baggage-header propagation. -->
        <dependency>
            <groupId>com.parasoft</groupId>
            <artifactId>coverage-integration-selenium</artifactId>
            <version>${coverage.integration.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <version>1.7.36</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <useModulePath>false</useModulePath>
                    <skipTests>${selenium.cucumber.tests.skip}</skipTests>

                    <!-- Required: execute the dedicated TestNG suite running the Cucumber runner. -->
                    <suiteXmlFiles>
                        <suiteXmlFile>${testng.suite.file}</suiteXmlFile>
                    </suiteXmlFiles>

                    <systemPropertyVariables>
                        <app.base.url>${app.base.url}</app.base.url>
                        <app.username>${app.username}</app.username>
                        <app.password>${app.password}</app.password>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>run-cucumber-selenium-tests</id>
            <properties>
                <selenium.cucumber.tests.skip>false</selenium.cucumber.tests.skip>
            </properties>
        </profile>
    </profiles>
</project>
