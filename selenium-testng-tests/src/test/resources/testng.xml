<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="WildflyExample Selenium Suite" verbose="1">
    <listeners>
        <!-- Required: starts/stops coverage session for the TestNG suite. -->
        <listener class-name="com.parasoft.coverage.integration.testng.ParasoftTestNGSuiteListener"/>
        <!-- Required: reports per-test execution and associates browser coverage to each test. -->
        <listener class-name="com.parasoft.coverage.integration.testng.ParasoftTestNGTestListener"/>
    </listeners>

    <test name="BrowserSmoke">
        <classes>
            <class name="com.app.selenium.LoginAndNavigationTest"/>
        </classes>
    </test>
</suite>
